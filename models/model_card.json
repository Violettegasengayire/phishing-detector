{
  "model_version": "3.0.0-hostname-ngram",
  "dataset": "UCI PhiUSIIL (2024) phishing hosts + Tranco legitimate hosts",
  "dataset_rows": 302728,
  "architecture": "MLPClassifier (feedforward neural network)",
  "engineered_features": 23,
  "ngram_features": 20000,
  "input_dimensions": 20023,
  "hidden_layers": [
    128,
    64
  ],
  "activation": "relu",
  "optimizer": "adam",
  "learning_rate_init": 0.001,
  "batch_size": 512,
  "l2_alpha": 0.0001,
  "early_stopping": true,
  "random_state": 42,
  "n_iter": 11,
  "decision_threshold": 0.8400000000000005,
  "threshold_selection": "Most sensitive threshold on the validation split that keeps precision >= 0.95. Not tuned on test data or on example sites.",
  "feature_names": [
    "host_length",
    "n_labels",
    "n_subdomains",
    "longest_label_length",
    "mean_label_length",
    "tld_length",
    "is_free_tld",
    "n_hyphens",
    "hyphen_ratio",
    "n_digits",
    "digit_ratio",
    "has_digit_in_tld_label",
    "host_entropy",
    "vowel_ratio",
    "max_consonant_run",
    "is_ip_host",
    "is_shortener",
    "https_token_in_host",
    "n_sensitive_words",
    "has_hex_escape",
    "has_punycode",
    "n_unique_chars",
    "repeated_char_ratio"
  ],
  "class_mapping": {
    "0": "Legitimate",
    "1": "Phishing"
  },
  "label_source": "is_phishing from build_dataset.py: 1 phishing (PhiUSIIL 2024), 0 legitimate (Tranco). Class 1 is phishing so predict_proba[:, 1] is P(phishing).",
  "scope": "hostname only; paths and query strings are ignored"
}